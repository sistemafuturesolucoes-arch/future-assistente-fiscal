{
  "manifest_version": 3,
  "name": "Future Guia — Assistente do emissor",
  "version": "1.0.0",
  "description": "Encontre cadastros e emissão de notas com orientação visual, passo a passo, no seu emissor.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/manual-knowledge.json"
      ],
      "matches": [
        "https://sistema.emissorfiscalonline.com.br/*"
      ]
    }
  ],
  "host_permissions": [
    "https://sistema.emissorfiscalonline.com.br/*",
    "https://itbppoailqkuxajesgys.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sistema.emissorfiscalonline.com.br/*"
      ],
      "js": [
        "src/knowledge.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
